{
  "name": "hikari-operator-assist",
  "description": "光回線コールセンター向けオペレーターアシストツール",
  "author": "Hikari",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"cross-env NODE_ENV=development vite\" \"wait-on http://localhost:5173/hikari-oa/ && cross-env NODE_ENV=development node electron/launch.js\"",
    "build": "vite build",
    "build:electron": "cross-env BUILD_TARGET=electron CSC_IDENTITY_AUTO_DISCOVERY=false vite build && electron-rebuild && electron-builder",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "electron-updater": "^6.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^8.0.0-beta.13",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  },
  "build": {
    "appId": "com.hikari.operator-assist",
    "productName": "Hikari Operator Assist",
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/test.js"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["ja"],
      "language": "1041"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "publish": {
      "provider": "github",
      "owner": "doiriyo",
      "repo": "hikari-operator-assist"
    }
  }
}
